#include <Arduino.h>
#include <DHTesp.h>
#include "LoRaWan_APP.h"

// ------------------ NPK ------------------
#define RE 23
#define DE 22
#define RXD2 16
#define TXD2 17
HardwareSerial mod(2); // UART2

const byte nitro[] = {0x01,0x03,0x00,0x1E,0x00,0x01,0xE4,0x0C};
const byte phos[]  = {0x01,0x03,0x00,0x1F,0x00,0x01,0xB5,0xCC};
const byte pota[]  = {0x01,0x03,0x00,0x20,0x00,0x01,0x85,0xC0};

// ------------------ MQ-135 y UV ------------------
#define MQ135_PIN 39
#define s12_pin 35
#define RL_VALUE 10.0
#define CO2_TARGET 400
float R0 = 10.0;

// ------------------ DHT22 ------------------
#define DHT_PIN 25
DHTesp dht;

// ------------------ LoRa ------------------
#define RF_FREQUENCY 915000000
#define TX_OUTPUT_POWER 14
#define LORA_BANDWIDTH 0
#define LORA_SPREADING_FACTOR 7
#define LORA_CODINGRATE 1
#define LORA_PREAMBLE_LENGTH 8
#define LORA_FIX_LENGTH_PAYLOAD_ON false
#define LORA_IQ_INVERSION_ON false

#define BUFFER_SIZE 200
char txpacket[BUFFER_SIZE];
char rxpacket[BUFFER_SIZE];

bool lora_idle = true;
unsigned long lastSendTime = 0;
const unsigned long interval = 10000; // 10 seg
unsigned long messageCount = 0;

// LoRa event callbacks
static RadioEvents_t RadioEvents;
void OnTxDone(void);
void OnTxTimeout(void);
void OnRxDone(uint8_t *payload,uint16_t size,int16_t rssi,int8_t snr);

// ------------------ Funciones NPK ------------------
uint16_t modbusCRC(const byte *buf, uint8_t len){
  uint16_t crc = 0xFFFF;
  for(uint8_t pos=0; pos<len; pos++){
    crc ^= (uint16_t)buf[pos];
    for(uint8_t i=0;i<8;i++){
      if(crc & 0x0001) crc = (crc>>1)^0xA001;
      else crc >>=1;
    }
  }
  return crc;
}

int readSensor(const byte* cmd){
  while(mod.available()) mod.read();

  digitalWrite(DE,HIGH);
  digitalWrite(RE,HIGH);
  delay(5);
  mod.write(cmd,8);
  mod.flush();
  delay(5);
  digitalWrite(DE,LOW);
  digitalWrite(RE,LOW);

  byte buf[32]; uint8_t index=0;
  unsigned long start=millis();
  while(millis()-start<500){
    while(mod.available()){
      if(index<sizeof(buf)) buf[index++] = mod.read();
    }
  }

  for(uint8_t i=0;i+6<index;i++){
    if(buf[i]==0x01 && buf[i+1]==0x03 && buf[i+2]==0x02){
      uint16_t crc_calc = modbusCRC(buf+i,5);
      uint16_t crc_recv = (uint16_t)buf[i+5]|((uint16_t)buf[i+6]<<8);
      if(crc_calc!=crc_recv){
        Serial.println("Error: CRC invalido");
        continue;
      }
      int value = (buf[i+3]<<8)|buf[i+4];
      return value;
    }
  }

  Serial.println("Error: no se encontró bloque válido");
  Serial.print("Datos recibidos ("); Serial.print(index); Serial.println(" bytes):");
  for(uint8_t i=0;i<index;i++){
    if(buf[i]<0x10) Serial.print("0");
    Serial.print(buf[i],HEX); Serial.print(" ");
  }
  Serial.println();
  return -1;
}

// ------------------ Funciones MQ-135/UV ------------------
float getRS(int analogValue){ return ((3.3 - analogValue*(3.3/4095.0))*RL_VALUE)/(analogValue*(3.3/4095.0)); }
float calcularR0(float rs,float co2_target){ return rs / pow(10,(2.602 - log10(co2_target))/2.769); }
float getCO2ppm(float rs_ro_ratio){ return pow(10,(-2.769*log10(rs_ro_ratio)+2.602)); }
float getNH3ppm(float co2){ return pow(10,(-1.8*((2.602 - log10(co2))/2.769)+1.5))*0.02; }

void calibrarR0(){
  const int muestras=100; float rs_total=0;
  for(int i=0;i<muestras;i++){
    rs_total += getRS(analogRead(MQ135_PIN));
    delay(30);
  }
  R0 = calcularR0(rs_total/muestras,CO2_TARGET);
  Serial.println("=== Calibracion MQ-135 ===");
  Serial.print("RS promedio: "); Serial.println(rs_total/muestras,2);
  Serial.print("R0 calibrado: "); Serial.println(R0,2);
}

// ------------------ Setup ------------------
void setup(){
  Serial.begin(115200);

  mod.begin(9600,SERIAL_8N1,RXD2,TXD2);
  pinMode(RE,OUTPUT); pinMode(DE,OUTPUT); digitalWrite(RE,LOW); digitalWrite(DE,LOW);

  dht.setup(DHT_PIN,DHTesp::DHT22);

  pinMode(s12_pin,INPUT);
  calibrarR0();

  Mcu.begin(HELTEC_BOARD,SLOW_CLK_TPYE);
  RadioEvents.TxDone = OnTxDone;
  RadioEvents.TxTimeout = OnTxTimeout;
  RadioEvents.RxDone = OnRxDone;
  Radio.Init(&RadioEvents);
  Radio.SetChannel(RF_FREQUENCY);
  Radio.SetTxConfig(MODEM_LORA, TX_OUTPUT_POWER,0,LORA_BANDWIDTH,LORA_SPREADING_FACTOR,LORA_CODINGRATE,LORA_PREAMBLE_LENGTH,LORA_FIX_LENGTH_PAYLOAD_ON,true,0,0,LORA_IQ_INVERSION_ON,3000);
  Radio.Rx(0);
}

// ------------------ Loop ------------------
void loop(){
  Radio.IrqProcess();
  unsigned long currentTime = millis();
  if(lora_idle && (currentTime - lastSendTime >= interval)){
    lastSendTime = currentTime;
    messageCount++;

    // --- Leer NPK ---
    int valN = readSensor(nitro);
    int valP = readSensor(phos);
    int valK = readSensor(pota);

    // --- MQ-135 ---
    float rs=-1, rs_ro_ratio=-1, co2=-1, nh3=-1;
    int analogValue = analogRead(MQ135_PIN);
    if(analogValue>=0){
      rs = getRS(analogValue);
      rs_ro_ratio = rs/R0;
      co2 = getCO2ppm(rs_ro_ratio);
      nh3 = getNH3ppm(co2);
    } else {
      Serial.println("MQ135 read error");
    }

    // --- UV ---
    float uv_index=-1;
    int sensorValue = analogRead(s12_pin);
    if(sensorValue>=0) uv_index = (sensorValue*(3.3/4095.0))*10.0;
    else Serial.println("UV sensor read error");

    // --- DHT22 ---
    TempAndHumidity data = dht.getTempAndHumidity();
    float temp=-999, hum=-999;
    String dht_error="";
    if(dht.getStatus()!=DHTesp::ERROR_NONE){
      dht_error="DHT error";
      Serial.println("DHT22 read failed: "+String(dht.getStatusString()));
    } else {
      temp = data.temperature;
      hum  = data.humidity;
    }

    // --- Crear paquete JSON ---
    snprintf(txpacket,BUFFER_SIZE,
      "{\"id\":%lu,\"t\":%.1f,\"h\":%.1f,\"co2\":%.1f,\"nh3\":%.1f,\"uv\":%.2f,\"N\":%d,\"P\":%d,\"K\":%d,\"DHT\":\"%s\"}",
      messageCount,temp,hum,co2,nh3,uv_index,valN,valP,valK,dht_error.c_str());

    Serial.printf("Sending (%lu): %s\n",messageCount,txpacket);
    Radio.Send((uint8_t*)txpacket,strlen(txpacket));
    lora_idle = false;
  }
}

// ------------------ Callbacks LoRa ------------------
void OnTxDone(void){ Serial.println("LoRa TX done"); lora_idle=true; Radio.Rx(0); }
void OnTxTimeout(void){ Serial.println("LoRa TX timeout"); lora_idle=true; Radio.Rx(0); }
void OnRxDone(uint8_t *payload,uint16_t size,int16_t rssi,int8_t snr){
  memcpy(rxpacket,payload,size);
  rxpacket[size]='\0';
  Serial.printf("Received: %s | RSSI: %d, SNR: %d\n",rxpacket,rssi,snr);

  if(String(rxpacket)=="chau"){
    Serial.println("Received 'chau', responding...");
    snprintf(txpacket,BUFFER_SIZE,"{\"reply\":\"chau recibido\", \"id\":%lu}",messageCount);
    Radio.Send((uint8_t*)txpacket,strlen(txpacket));
    lora_idle=false;
  } else {
    Radio.Rx(0);
  }
}
